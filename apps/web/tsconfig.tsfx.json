{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@tsfx/*": ["./src/tsfx/*"],
      "@web/*": ["./src/*"]
    }
  },
  "include": ["src/tsfx/**/*.ts", "src/tsfx/**/*.tsx", "src/tsfx-entry.d.ts"]
}
