# Copy to .env — .env is gitignored and must never be committed.
# Password for the SAP technical user named in config/services.json.
SAP_DS4_100_NIIF_PASSWORD=NIIFDevelopment@Fourth2026

# Gateway port. Replaces the old per-console ports 8765-8775.
PORT=8080

# Point the backend registry somewhere else (tests, local mocks). Defaults to config/services.json.
# SLC_SERVICES_CONFIG=

# Local SQLite database (application-specific data only; SAP stays the source of truth for
# SAP transactions). Relative paths resolve from the repo root. Defaults to ./data/tsf-fx.db.
# SQLITE_PATH=./data/tsf-fx.db

# Demo login credentials (demo auth mode only — not a security boundary).
DEMO_USER=demo
DEMO_PASSWORD=demo

# Signs the sign-in cookie. Unset, the gateway picks a random one on every start, so each
# restart (including `npm run dev` reloading after a change) signs everyone out and every
# screen answers "Not signed in.". Set any long random string to keep sessions.
AUTH_SECRET=
